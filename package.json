{
  "name": "emoton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sources in, narrated explainer video out",
  "scripts": {
    "make": "tsx pipeline/cli.ts",
    "studio": "remotion studio src/remotion/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "export:public": "tsx scripts/export-public.ts",
    "server": "tsx server/main.ts",
    "ui:dev": "vite --config app/vite.config.ts",
    "ui:build": "vite build --config app/vite.config.ts",
    "app:dev": "tauri dev",
    "app:build": "npm run ui:build && tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/busboy": "^1.5.4",
    "@types/katex": "^0.16.8",
