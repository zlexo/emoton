{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emoton",
  "version": "0.1.0",
  "identifier": "me.zlex.emoton",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Emoton",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Dark",
        "backgroundColor": "#0E0E10",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "shortDescription": "Sources in, narrated explainer video out",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
