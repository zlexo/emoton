{"duration":52.6525,"beats":[{"start":0.3,"end":5.6129999999999995,"sentences":[{"start":0.3,"end":4.449,"text":"Last time, this world got its textures. Today, it gets someone to live in it.","words":[{"text":"Last","start":0.318,"end":0.568},{"text":"time,","start":0.593,"end":0.868},{"text":"this","start":1.0430000000000001,"end":1.193},{"text":"world","start":1.243,"end":1.468},{"text":"got","start":1.518,"end":1.668},{"text":"its","start":1.693,"end":1.793},{"text":"textures.","start":1.843,"end":2.518},{"text":"Today,","start":2.8179999999999996,"end":3.1929999999999996},{"text":"it","start":3.368,"end":3.4179999999999997},{"text":"gets","start":3.468,"end":3.643},{"text":"someone","start":3.6929999999999996,"end":3.893},{"text":"to","start":3.9429999999999996,"end":4.018},{"text":"live","start":4.068,"end":4.218},{"text":"in","start":4.243,"end":4.293},{"text":"it.","start":4.343,"end":4.409}]},{"start":4.669,"end":5.6129999999999995,"text":"So I added a player.","words":[{"text":"So","start":4.683,"end":4.7829999999999995},{"text":"I","start":4.808,"end":4.858},{"text":"added","start":4.9079999999999995,"end":5.083},{"text":"a","start":5.108,"end":5.133},{"text":"player.","start":5.183,"end":5.5729999999999995}]}]},{"start":6.063,"end":23.069,"sentences":[{"start":6.063,"end":9.087,"text":"He spawned magenta. Like everything I make, at first.","words":[{"text":"He","start":6.063,"end":6.131},{"text":"spawned","start":6.181,"end":6.481},{"text":"magenta.","start":6.506,"end":7.056},{"text":"Like","start":7.4559999999999995,"end":7.606},{"text":"everything","start":7.656,"end":7.981},{"text":"I","start":8.031,"end":8.131},{"text":"make,","start":8.181000000000001,"end":8.381},{"text":"at","start":8.556000000000001,"end":8.606},{"text":"first.","start":8.656,"end":9.046999999999999}]},{"start":9.557,"end":10.626,"text":"Let's get a closer look.","words":[{"text":"Let's","start":9.557,"end":9.7},{"text":"get","start":9.725,"end":9.799999999999999},{"text":"a","start":9.825,"end":9.85},{"text":"closer","start":9.9,"end":10.2},{"text":"look.","start":10.25,"end":10.586}]},{"start":10.846,"end":15.348,"text":"No face. No name. No idea where he is. Honestly? Relatable.","words":[{"text":"No","start":10.863999999999999,"end":11.039},{"text":"face.","start":11.089,"end":11.363999999999999},{"text":"No","start":11.664,"end":11.764},{"text":"name.","start":11.814,"end":12.014},{"text":"No","start":12.314,"end":12.414000000000001},{"text":"idea","start":12.464,"end":12.789000000000001},{"text":"where","start":12.839,"end":12.989},{"text":"he","start":13.039000000000001,"end":13.164000000000001},{"text":"is.","start":13.239,"end":13.464},{"text":"Honestly?","start":13.863999999999999,"end":14.363999999999999},{"text":"Relatable.","start":14.764,"end":15.308}]},{"start":15.568,"end":21.118,"text":"Every legend needs a name. I named him after the engine, because creativity is expensive.","words":[{"text":"Every","start":15.586,"end":15.836},{"text":"legend","start":15.886,"end":16.286},{"text":"needs","start":16.336,"end":16.561},{"text":"a","start":16.586,"end":16.611},{"text":"name.","start":16.661,"end":17.086},{"text":"I","start":17.386,"end":17.486},{"text":"named","start":17.535999999999998,"end":17.785999999999998},{"text":"him","start":17.811,"end":17.986},{"text":"after","start":18.035999999999998,"end":18.285999999999998},{"text":"the","start":18.311,"end":18.410999999999998},{"text":"engine,","start":18.461,"end":18.860999999999997},{"text":"because","start":19.161,"end":19.411},{"text":"creativity","start":19.461,"end":20.136},{"text":"is","start":20.211,"end":20.311},{"text":"expensive.","start":20.361,"end":21.078}]},{"start":21.338,"end":21.906,"text":"Perdix.","words":[{"text":"Perdix.","start":21.338,"end":21.866}]},{"start":22.376,"end":23.069,"text":"And a face.","words":[{"text":"And","start":22.376,"end":22.444},{"text":"a","start":22.469,"end":22.519},{"text":"face.","start":22.594,"end":23.029}]}]},{"start":23.619,"end":29.697000000000003,"sentences":[{"start":23.619,"end":26.368000000000002,"text":"Then I taught him to walk, at Minecraft's exact speeds.","words":[{"text":"Then","start":23.619,"end":23.712},{"text":"I","start":23.737000000000002,"end":23.812},{"text":"taught","start":23.862000000000002,"end":24.037000000000003},{"text":"him","start":24.062,"end":24.162000000000003},{"text":"to","start":24.212,"end":24.287000000000003},{"text":"walk,","start":24.337,"end":24.662000000000003},{"text":"at","start":24.837,"end":24.912},{"text":"Minecraft's","start":24.962,"end":25.387},{"text":"exact","start":25.437,"end":25.762},{"text":"speeds.","start":25.812,"end":26.328}]},{"start":26.588,"end":27.098,"text":"Walk.","words":[{"text":"Walk.","start":26.606,"end":27.058}]},{"start":27.718,"end":28.317999999999998,"text":"Sprint.","words":[{"text":"Sprint.","start":27.755,"end":28.278}]},{"start":28.938000000000002,"end":29.697000000000003,"text":"Sprint-jump.","words":[{"text":"Sprint-jump.","start":28.950000000000003,"end":29.657}]}]},{"start":30.647,"end":31.616,"sentences":[{"start":30.647,"end":31.616,"text":"This is what he sees.","words":[{"text":"This","start":30.647,"end":30.79},{"text":"is","start":30.839999999999996,"end":30.915},{"text":"what","start":30.939999999999998,"end":31.04},{"text":"he","start":31.064999999999998,"end":31.14},{"text":"sees.","start":31.189999999999998,"end":31.576}]}]},{"start":32.866,"end":41.334,"sentences":[{"start":32.866,"end":35.039,"text":"And then, he met a block. One block.","words":[{"text":"And","start":32.866,"end":32.934},{"text":"then,","start":32.959,"end":33.084},{"text":"he","start":33.259,"end":33.334},{"text":"met","start":33.359,"end":33.459},{"text":"a","start":33.484,"end":33.509},{"text":"block.","start":33.559,"end":33.934},{"text":"One","start":34.334,"end":34.534},{"text":"block.","start":34.584,"end":34.999}]},{"start":35.259,"end":41.334,"text":"He just stands there. His legs don't even move: Minecraft only swi