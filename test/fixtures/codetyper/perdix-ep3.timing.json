tart":46.059,"end":46.159},{"text":"Perdix","start":46.208999999999996,"end":46.534},{"text":"learn","start":46.583999999999996,"end":46.734},{"text":"next?","start":46.784,"end":47.109},{"text":"Tell","start":47.409,"end":47.534},{"text":"me","start":47.559000000000005,"end":47.659},{"text":"in","start":47.684000000000005,"end":47.734},{"text":"the","start":47.734,"end":47.784},{"text":"comments.","start":47.834,"end":48.259},{"text":"Follow.","start":48.559,"end":48.961999999999996}]}]}]}